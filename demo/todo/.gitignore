# Tsumiki commits only its AUTHORED files: the app (app/), its requirements + flow + narration
# (spec/todo/), the board config (spec/_config.json), the app-base helper (spec/_app.ts), the static
# server (serve-app.mjs), package.json and this README. Everything below is VENDORED specboard code —
# a byte copy of the plugin's own tools/harness that `npm run setup` re-creates — so it is not
# committed a second time inside the same repo. Regenerate it with:  npm run setup
node_modules/
# npm's generated lockfile — regenerated by `npm run setup`, not an authored file
package-lock.json

# vendored skeleton (from tools/scaffold.mjs)
/tools/
/playwright.board.ts
/board.html
/spec/_base.ts
# …and the two modules _base.ts serialises into the page under test — the layout skeleton's walk and
# the replica's capture (both added to the skeleton on 2026-09-03; this list had not learnt them, so
# they arrived as untracked files inside a project whose whole policy is not to commit vendored code)
/spec/_layout-walk.mjs
/spec/_replica.mjs
# …and the composer that makes the walk and the replica ONE page pass (2026-09-04) — vendored like them
/spec/_moment.mjs
/spec/_design.css
/spec/_fixture.ts
/spec/_state-guard.ts
/spec/_state-guard-teardown.ts
/spec/_results-reporter.mjs
/spec/_auth.setup.ts
/spec/_seed.ts
/spec/_escapes.md
# (spec/_specboard.json is COMMITTED — it records the release AND the project's identity block,
#  `project: { name, tagline }`, the board crumb's authored source; Task 8 fix round 1)

# transient run state — AND EVERYTHING DERIVED (the data home, 2026-09-05/06: nothing a run makes is
# committed any more; the harvest, the fold, the run log and the generated board live in
# ~/.specboard/<projectId>/, content-addressed and gc'd by reference at every fold)
/spec/_results.json
/spec/_results-index.json
/spec/_runs.json
/spec/_runs/
/spec/*/evidence/
/spec/*/viz/
/spec/*/screen.png
/spec/*/crawl.png
/spec/_run-report.json
/spec/_state-snapshot.*.json
/spec/_dir-snapshot.*.json
/spec/_auth-state.json
# specboard update scratch
.specboard-backup-*/
*.new
# the saved authenticated session dir (specboard 0.45.0's own board-folder list)
spec/.auth/
